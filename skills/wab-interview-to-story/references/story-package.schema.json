{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chiwinzhong/wab-ai-native-brand-system/schemas/story-package.schema.json",
  "title": "WAB Interview-to-Story Package",
  "type": "object",
  "required": ["package_version", "project", "source_register", "evidence_ledger", "canonical_story", "deliverables", "visuals", "gates", "limitations"],
  "properties": {
    "package_version": {"const": "1.0"},
    "project": {
      "type": "object",
      "required": ["name", "story_id", "route", "source_language", "target_languages"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "story_id": {"type": "string", "minLength": 1},
        "route": {"enum": ["person_story", "place_choice_story"]},
        "source_language": {"type": "string", "minLength": 2},
        "target_languages": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}}
      },
      "additionalProperties": true
    },
    "source_register": {"type": "array", "minItems": 1},
    "evidence_ledger": {"type": "array", "minItems": 1},
    "canonical_story": {"type": "object"},
    "deliverables": {"type": "array", "minItems": 1},
    "visuals": {"type": "array"},
    "gates": {"type": "object"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": true
}
